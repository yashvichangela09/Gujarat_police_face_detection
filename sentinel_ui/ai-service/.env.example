# PostgreSQL used by the existing SENTINEL schema
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Only start AI on cameras you are authorized to process.
# One camera per line: CAMERA_ID=RTSP_OR_HLS_URL
CAM01=rtsp://USER:PASSWORD@CAMERA_IP:554/stream
CAM02=rtsp://USER:PASSWORD@CAMERA_IP:554/stream

# Optional
AI_HOST=0.0.0.0
AI_PORT=8100
YOLO_MODEL=yolo11n.pt
VEHICLE_MIN_CONF=0.45
FACE_MIN_SIZE=40
